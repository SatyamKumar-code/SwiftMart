PORT=3001
NODE_ENV=development
DATABASE_URL=postgresql://username:password@localhost:5432/dbname
FRONTEND_URL=http://localhost:5173

# Clerk Authentication
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
CLERK_WEBHOOK_SECRET=whsec_...

# Polar Billing
POLAR_ACCESS_TOKEN=polar_at_...
POLAR_WEBHOOK_SECRET=whsec_...
POLAR_CHECKOUT_PRODUCT_ID=your-polar-product-uuid
POLAR_API_BASE=https://api.polar.sh

# Stream Chat & Video (GetStream SDK)
STREM_API_KEY=your-stream-api-key
STREM_API_SECRET=your-stream-api-secret

# ImageKit Asset Hosting
IMAGEKIT_PUBLIC_KEY=your-imagekit-public-key
IMAGEKIT_PRIVATE_KEY=your-imagekit-private-key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your-id

# Observability
SENTRY_DSN=https://your-sentry-dsn
